<?xml version="1.0" encoding="UTF-8"?>
<!-- Hidden spreadsheet content: one hidden sheet ("Client contacts"), one
     hidden row (row 3) and one hidden column (column B), each holding
     fictional names. Visible names are spelled plainly; every name that
     must stay out of the Markdown is spelled HIDDEN-*. -->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:version="1.3"
    office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
  <office:automatic-styles>
    <style:style style:name="TaShown" style:family="table">
      <style:table-properties table:display="true"/>
    </style:style>
    <style:style style:name="TaHidden" style:family="table">
      <style:table-properties table:display="false"/>
    </style:style>
  </office:automatic-styles>
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Matters" table:style-name="TaShown">
        <table:table-column/>
        <table:table-column table:visibility="collapse"/>
        <table:table-column/>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>Client</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Referred by</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>Matter</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>Ada Quillfeather</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Hugo Brannock</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>Lease review</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:visibility="collapse">
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Bram Tolliver</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Ines Calloway</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Settlement draft</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>Cora Penhallow</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Jory Abernethy</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>Will update</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="Client contacts" table:style-name="TaHidden">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Dorian Vale</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-555 0101</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-Elspeth Marrow</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>HIDDEN-555 0102</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
